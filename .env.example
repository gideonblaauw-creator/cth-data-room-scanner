# CTH Data Room Scanner — environment variables
# Copy to .env and fill in. Never commit .env to git.
# For secrets at rest on VPS: use SOPS+age (key on VPS, never in git).

# ── Google Drive ─────────────────────────────────────────────────────────────
# Shared reports output folder (HTML + PDF uploads)
# https://drive.google.com/drive/folders/1RvuoSvbm6SvbdCWU06Wa7jyfEniPmzbP
DRIVE_REPORTS_FOLDER_ID=1RvuoSvbm6SvbdCWU06Wa7jyfEniPmzbP

# Service account JSON for Drive API (mount in compose, never commit)
GOOGLE_APPLICATION_CREDENTIALS=/secrets/google-sa.json

# ── LLM scoring ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── Paths (all optional — defaults to repo-relative) ─────────────────────────
OUTPUT_DIR=./output
SKILLS_DIR=./skills
TEMPLATES_DIR=./templates

# ── Seller legal entity (report footer) ────────────────────────────────────────
SELLER_LEGAL_NAME=CLEANTECHHUB INTERNATIONAL S.L.

# ── HTTP app ─────────────────────────────────────────────────────────────────
APP_HOST=127.0.0.1
APP_PORT=8080

# Comma-separated origins for React shell CORS (web/ dev server + apps host)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://apps.cleantechhub.net

# ── Redis / RQ queue ─────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
RQ_QUEUE_NAME=cth-scans
