# CTH Data Room Scanner — environment variables
# Copy to .env and fill in. Never commit .env to git.
# Each team member fills in their own copy.

# Google Drive — shared reports folder
# drive.google.com/drive/folders/1RvuoSvbm6SvbdCWU06Wa7jyfEniPmzbP
DRIVE_REPORTS_FOLDER_ID=1RvuoSvbm6SvbdCWU06Wa7jyfEniPmzbP

# Output dir (local working copy — gitignored)
OUTPUT_DIR=./output

# Google Drive MCP auth is handled by Claude Desktop — no API key needed here.
# Make sure Google Drive is connected in Claude Desktop Settings → Connectors.

