# Flask scan API (CTH pod). Local dev uses Vite proxy — set for hosted builds.
VITE_API_URL=http://127.0.0.1:8080

# Vite base path (must match public URL path on apps.cleantechhub.net)
VITE_BASE_PATH=/dataroom-scanner/

# Public shell URL (documentation / CORS reference)
# PUBLIC_URL=https://apps.cleantechhub.net/dataroom-scanner
